# Copy to .env. `npm run dev` and `npm start` load it automatically.
PORT=4318
API_PORT=4319
DATA_DIR=./data
# SQLite remains the local default. Azure deployment configures azure-sql.
DATABASE_PROVIDER=sqlite
# For Azure SQL development, use SQL_AUTH=azure-cli after `az login`.
# SQL_SERVER=your-server.database.windows.net
# SQL_DATABASE=nourish-board
# SQL_AUTH=azure-cli
# DATABASE_MIGRATIONS=on
APP_URL=http://localhost:4318
ADMIN_EMAIL=suhas.bangre@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional free nutrition API key. Defaults to USDA's limited DEMO_KEY.
USDA_API_KEY=DEMO_KEY
# Optional LOCAL preview only: never enable on a hosted instance.
LOCAL_DEV_AUTH=false
# NODE_ENV=production
